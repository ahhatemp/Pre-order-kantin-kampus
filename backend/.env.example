# Salin ke .env lalu sesuaikan

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=kantin

# WAJIB diganti sebelum produksi
JWT_SECRET=ganti-dengan-string-acak-panjang

# Midtrans (kosongkan kalau belum dipakai)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Batas rate limit
RATE_LIMIT_ORDER_MAX=20
