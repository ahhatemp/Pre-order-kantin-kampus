# Salin ke .env lalu sesuaikan

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=kantin

# WAJIB diganti sebelum produksi
JWT_SECRET=ganti-dengan-string-acak-panjang

# Midtrans (kosongkan semua = mode demo: QRIS langsung dianggap lunas, tunai tetap pending)
# Sandbox  : server key SB-Mid-server-...  | client key SB-Mid-client-...
# Produksi : server key Mid-server-...     | client key Mid-client-...
# MIDTRANS_IS_PRODUCTION WAJIB cocok dengan prefix key. Bila tidak cocok,
# POST /api/orders (QRIS) ditolak dan webhook dibalas 503 (fail closed).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Batas rate limit
RATE_LIMIT_ORDER_MAX=20
ORDER_PENDING_MAX=3

# Web Push (VAPID)
VAPID_SUBJECT=mailto:admin@kantin.com
# Opsional: simpan kunci privat di luar web root, mis. /var/www/secrets/kantin-vapid.json
VAPID_KEY_FILE=
